#!name=CN Games, WeChat & HeyBox Direct
#!desc=Personal DIRECT rules for selected CN games, WeChat mini-program services and HeyBox. No FINAL, GEOIP or DNS overrides; airport config stays untouched.

[Rule]
# Arknights CN: Hypergryph
DOMAIN-SUFFIX,hypergryph.com,DIRECT

# Brawl Stars CN: Tencent / CN official domains
DOMAIN,bs.qq.com,DIRECT
DOMAIN-SUFFIX,brawlstars.cn,DIRECT

# WeChat and mini-program platform (not all third-party mini-program domains)
DOMAIN-SUFFIX,servicewechat.com,DIRECT
DOMAIN-SUFFIX,weixin.qq.com,DIRECT
DOMAIN-SUFFIX,wechat.com,DIRECT
DOMAIN-SUFFIX,qpic.cn,DIRECT

# HeyBox / Xiaoheihe: official web and API domains
DOMAIN-SUFFIX,xiaoheihe.cn,DIRECT

# HeyBox image CDN observed in Shadowrocket rule test
# Exact host only: avoid forcing unrelated max-c.com services to DIRECT
DOMAIN,imgheybox.max-c.com,DIRECT

# Douyin / ByteDance CN services: keep API and assets DIRECT
DOMAIN-SUFFIX,amemv.com,DIRECT
DOMAIN-SUFFIX,bytegecko.com,DIRECT
DOMAIN-SUFFIX,ecombdapi.com,DIRECT

# No catch-all rules; all unlisted domains continue through the airport config.
